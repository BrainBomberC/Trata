+
+bool ggml_backend_capture_end(ggml_backend_t backend, void ** exec) {
+    GGML_ASSERT(backend);
+    if (backend->iface.capture_end == NULL) {
+        return false;
+    }
+    return backend->iface.capture_end(backend, exec);
+}
+
+void ggml_backend_capture_launch(ggml_backend_t backend, void * exec) {
+    GGML_ASSERT(backend);
+    GGML_ASSERT(backend->iface.capture_launch != NULL);
+    backend->iface.capture_launch(backend, exec);
+}
+
+void ggml_backend_capture_free(ggml_backend_t backend, void * exec) {
+    GGML_ASSERT(backend);
+    if (backend->iface.capture_free == NULL) {
+        return;
+    }
+    backend->iface.capture_free(backend, exec);
+}
