+//
+// mtmd_image_preprocessor_nemotron_omni_video
+//
+
+clip_image_size mtmd_image_preprocessor_nemotron_omni_video::target_video_size(
+        const clip_hparams & hparams,
+        const clip_image_size & original_size) {
+    GGML_ASSERT(original_size.width > 0 && original_size.height > 0);
+    GGML_ASSERT(hparams.patch_size > 0 && hparams.n_merge > 0);
+
+    const int patch_area = hparams.patch_size * hparams.patch_size;
+    GGML_ASSERT(hparams.image_min_pixels > 0 && hparams.image_min_pixels % patch_area == 0);
+    const int target = hparams.image_min_pixels / patch_area;
+    const double aspect = static_cast<double>(original_size.width) / original_size.height;
+    auto py_round = [](double value) { return static_cast<int>(std::nearbyint(value)); };
+
+    int target_h = std::max(py_round(std::sqrt(target / aspect)), 1);
+    int target_w = std::max(py_round(std::sqrt(target * aspect)), 1);
+    const int divisor = hparams.n_merge;
+    if (divisor > 1) {
+        const int rem_h = target_h % divisor;
+        const int rem_w = target_w % divisor;
+        const int h_up = target_h + (rem_h ? divisor - rem_h : 0);
+        const int w_up = target_w + (rem_w ? divisor - rem_w : 0);
+        if (h_up * w_up <= target) {
+            target_h = h_up;
+            target_w = w_up;
+        } else {
+            target_h = std::max(divisor, target_h - rem_h);
+            target_w = std::max(divisor, target_w - rem_w);
+        }
+    }
+
+    return {target_w * hparams.patch_size, target_h * hparams.patch_size};
+}
+
+mtmd_image_preproc_out mtmd_image_preprocessor_nemotron_omni_video::preprocess(const clip_image_u8 & img) const {
+    const clip_image_size target_size = target_video_size(hparams, img.get_size());
+
+    clip_image_u8 resized_image;
+    img_tool::resize(img, resized_image, target_size, hparams.image_resize_algo, PAD_NONE);
+
+    mtmd_image_preproc_out output;
+    output.append(hparams, resized_image, true);
+    return output;
+}
