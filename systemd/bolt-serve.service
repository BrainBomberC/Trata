# bolt-serve.service —— 生产配置：层切分 3 卡 + LiLiCorr(DFlash) 草稿 + 1M 上下文
#
# 实测 decode 54–55 tok/s（greedy，接受长度 3.42），对比旧 TP×3 无草稿 46.6–47.7。
# 回退单元：bolt-serve-tp.service（旧 TP 配置），两者互斥。
#
# 安装:
#   cp systemd/bolt-serve.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now bolt-serve.service
#
# 需要改的路径（假设仓库在 ~/Nemotron3Super）:
#   LD_LIBRARY_PATH 里的 NCCL 目录（按实际 python 版本调整）
#   ExecStart 里的 llama-server、模型、草稿、投影器
#
# 视觉投影器必须是 Bolt 仓库那份（519 张量）。旧的 120B 投影器能加载但图像描述全错。

[Unit]
Description=Bolt 74B (IQ2_XXS) + LiLiCorr draft, layer split x3, 1M ctx — 54 tok/s
After=network.target
Conflicts=bolt-serve-tp.service

[Service]
Type=simple
WorkingDirectory=%h/Nemotron3Super
Environment=LD_LIBRARY_PATH=%h/nccl-venv/lib/python3.12/site-packages/nvidia/nccl/lib:%h/Nemotron3Super/llama.cpp/build-nccl/bin
MemorySwapMax=0
ExecStart=%h/Nemotron3Super/llama.cpp/build-nccl/bin/llama-server \
  -m %h/Nemotron3Super/model/bolt74b/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-IQ2_XXS.gguf \
  -ngl all -sm layer -ts 1,1,1 -fa on \
  -ctk q4_0 -ctv q4_0 -c 1048576 -ub 64 -t 17 -np 1 -fit off \
  -md %h/Nemotron3Super/model/draft/dflash-NVIDIA-Nemotron-3.5-Bolt-74B-A9B-NVFP4.gguf \
  -ngld all --spec-type draft-dflash --spec-draft-n-max 4 --spec-draft-n-min 0 \
  -mm %h/Nemotron3Super/model/mmproj-BF16.gguf --no-mmproj-offload \
  --override-kv nemotron_h_moe.context_length=int:1048576 \
  --metrics --host 127.0.0.1 --port 8080 -lv 3
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
